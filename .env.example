APP_ENV=production
DEBUG=false
STRICT_STARTUP_VALIDATION=true
DB_AUTO_CREATE=false
RUN_MIGRATIONS_ON_STARTUP=true

POSTGRES_DB=drugguard
POSTGRES_USER=drugguard
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://drugguard:change-me@postgres:5432/drugguard
REDIS_URL=redis://redis:6379/0

JWT_SECRET=replace-with-a-long-random-secret
API_KEY=replace-with-admin-api-key
CORS_ORIGINS=http://localhost
UVICORN_WORKERS=2
NGINX_PORT=80

VITE_API_URL=/api
VITE_API_URL_MOBILE=

GOOGLE_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENFDA_API_KEY=
UMLS_API_KEY=
