# =============================================================================
# Environment Variables for DrugGuard Frontend
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# =============================================================================

# Backend API URL (for web browser)
VITE_API_URL=http://localhost:8000

# Backend API URL for Mobile App
# When running on Android device, use your computer's local network IP
# Example: If your computer IP is 192.168.1.100, use:
# VITE_API_URL_MOBILE=http://192.168.1.100:8001
#
# For production, use your deployed backend URL:
# VITE_API_URL_MOBILE=https://your-backend.railway.app
VITE_API_URL_MOBILE=http://YOUR_LOCAL_IP:8001
