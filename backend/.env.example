# =============================================================================
# Environment Variables for DrugGuard Backend
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# =============================================================================

# Google Gemini API Key (for prescription OCR and chat)
# Get one from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_google_api_key_here

# Optional: Google Cloud Speech-to-Text API key (if Cloud STT is enabled)
CLOUD_SPEECH_API_KEY=your_google_cloud_speech_api_key_here

# Ollama Configuration (for local LLM)
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_DRUG_CHECK_MODEL=gpt-oss:120b-cloud
OLLAMA_HOST=http://localhost:11434

# Database URL
# For local SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./data/drugguard.db
# For Docker/PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://drugguard:change-me@postgres:5432/drugguard

# Database bootstrap
# Use Alembic in production and keep ORM auto-create disabled.
# DB_AUTO_CREATE=false

# Optional: Debug mode
# DEBUG=true

# Optional: Environment and startup hardening
# APP_ENV=production
# STRICT_STARTUP_VALIDATION=true
# REQUIRE_API_KEY_FOR_ADMIN=true
# REQUIRE_GEMINI_KEY=true
# ENABLE_CLOUD_SPEECH=false
# LOG_LEVEL=INFO

# Security
# JWT_SECRET=replace-with-a-long-random-secret
# API_KEY=replace-with-admin-api-key
